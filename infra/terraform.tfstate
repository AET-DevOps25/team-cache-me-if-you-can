          "attributes": {
            "binary_data": {},
            "data": {
              "init.sql": "CREATE DATABASE IF NOT EXISTS files_database;\nCREATE DATABASE IF NOT EXISTS user_database;\nCREATE DATABASE IF NOT EXISTS group_database;\n\nCREATE USER IF NOT EXISTS 'files'@'%' IDENTIFIED BY 'Files123!';\nGRANT ALL PRIVILEGES ON files_database.* TO 'files'@'%';\n\nCREATE USER IF NOT EXISTS 'user'@'%' IDENTIFIED BY 'User123!';\nGRANT ALL PRIVILEGES ON user_database.* TO 'user'@'%';\n\nCREATE USER IF NOT EXISTS 'group'@'%' IDENTIFIED BY 'Group123!';\nGRANT ALL PRIVILEGES ON group_database.* TO 'group'@'%';\n\nFLUSH PRIVILEGES;\n"
            },
            "id": "developmentv1/mysql-initdb-config",
            "immutable": false,
            "metadata": [
              {
                "annotations": {},
                "generate_name": "",
                "generation": 0,
                "labels": {},
                "name": "mysql-initdb-config",
                "namespace": "developmentv1",
                "resource_version": "42889174",
